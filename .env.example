# ---------------------------------------------------------------------------
# Autonome KI-Trading-Firma — Konfiguration
#
# Kopieren mit:  cp .env.example .env
# Danach anpassen. Die Datei enthält Zugangsdaten → chmod 600 .env
# ---------------------------------------------------------------------------

# --- Datenbank (Pflicht) ---------------------------------------------------
DATABASE_URL=postgresql://trader:bitte-hier-aendern@127.0.0.1:5432/trading_firm


# --- Modellserver ----------------------------------------------------------
# LLM_PROVIDER = ollama   → nativer Ollama-Server (Standard)
#              = openai   → jeder OpenAI-kompatible Endpunkt:
#                           llama.cpp llama-server, LM Studio, vLLM, LocalAI
#                           oder ein Cloud-Anbieter (ChatGPT/OpenAI, DeepSeek …)
#              = gemini   → Google Gemini (GEMINI_API_KEY nötig)
#              = anthropic→ Anthropic Claude (ANTHROPIC_API_KEY nötig)
#
# Fallback-Kette: LLM_FALLBACK_PROVIDERS=gemini,anthropic versucht bei Ausfall
# des primären Providers die nächsten Provider der Liste (kommagetrennt).
LLM_PROVIDER=ollama
# LLM_FALLBACK_PROVIDERS=

# Variante A (Solo-Node, alles auf dem N150):
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Variante B (Split-Node, Modelle auf dem Desktop) — IP anpassen:
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# Variante B mit RX 480 über Vulkan (llama.cpp llama-server):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://192.168.1.50:8080/v1
# LLM_MODEL=qwen-local
# LLM_API_KEY=

# Cloud-Provider (optional, nur wenn du bewusst Cloud-Kosten willst):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza…
# LLM_MODEL=gemini-2.0-flash
# --- oder ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-…
# LLM_MODEL=claude-3-5-haiku-latest

# Kontextfenster. Größer = mehr Kontext, aber mehr RAM und langsamer.
# Variante A: 4096   ·   Variante B: 8192
OLLAMA_NUM_CTX=4096

# Max. Ausgabetokens pro Agenten-Aufruf (Kosten-/Performance-Hebel):
# klein = schneller & billiger, zu klein = abgeschnittene Antworten.
LLM_MAX_TOKENS=512

# Zeitlimit pro Modellantwort. Auf dem N150 großzügig wählen — sonst greift
# unnötig oft die Regel-Engine.
LLM_TIMEOUT_MS=180000

# Retries: Anzahl Versuche pro Provider bei Netzwerkfehler/429/5xx (1–5).
# 2 = ein Wiederholungsversuch (Standard), 1 = kein Retry (schnellster Betrieb).
LLM_MAX_ATTEMPTS=2

# Kosten-Schätzung fürs Dashboard/Log (USD je 1 Mio. Token; nur für Cloud).
# Lokale Provider (ollama) kosten immer 0. Defaults siehe docs/PROVIDER_INTEGRATION.md.
# LLM_COST_OPENAI_INPUT_PER_MTOK=0.15
# LLM_COST_OPENAI_OUTPUT_PER_MTOK=0.60
# LLM_COST_GEMINI_INPUT_PER_MTOK=0.125
# LLM_COST_GEMINI_OUTPUT_PER_MTOK=0.50
# LLM_COST_ANTHROPIC_INPUT_PER_MTOK=0.80
# LLM_COST_ANTHROPIC_OUTPUT_PER_MTOK=4.00

# --- Model Router (Task 09) ---------------------------------------------------
# Der MODEL_ROUTER entscheidet Modellklasse/Provider/Modell — KEIN Agent selbst.
# Details: docs/LLM_ROUTING.md
#
# Eigene Routing-Policy (JSON). Ungültige Policy => Startverweigerung.
# ROUTING_POLICY_PATH=/etc/ai-trading-firm/routing-policy.json
#
# Health-Poller: Intervall in ms (0 = aus). Default aus der Policy (60000).
# ROUTING_HEALTH_POLL_MS=60000
#
# Prüfumfang: off | local (Default; nur lokale Provider remote) | all (auch Cloud).
# ROUTING_HEALTH_PROBE=local
# ROUTING_HEALTH_TIMEOUT_MS=1500
#
# Tages-Token-Deckel je Provider (Überschreitung => Zwangsfallback auf lokal).
# Cloud-Provider MÜSSEN gedeckelt sein (nie unbegrenzt).
# ROUTING_BUDGET_OLLAMA_TOKENS=5000000
# ROUTING_BUDGET_OPENAI_TOKENS=500000
# ROUTING_BUDGET_GEMINI_TOKENS=200000
# ROUTING_BUDGET_ANTHROPIC_TOKENS=100000
#
# Admin-Token für PUT /api/routing/modes (Policy-Änderungen, auditiert).
# FIRM_ADMIN_TOKEN=


# --- Handelsbetrieb --------------------------------------------------------
# Startkapital des Paper-Kontos in Kontowährung.
STARTING_EQUITY=10000

# true  = kein Agent führt selbst aus; jeder Trade landet als PENDING in
#         'proposals' und muss von Hand freigegeben werden.
#         Empfohlen für die ersten Wochen.
# false = die Pipeline führt freigegebene Trades selbst aus (Paper).
REQUIRE_HUMAN_APPROVAL=false


# --- Modelle je Rolle ------------------------------------------------------
# Werden nur beim ERSTEN Seed verwendet. Später über die Datenbank ändern:
#   UPDATE agents SET model='…' WHERE role='CEO';
#
# ACHTUNG (Task 09): Seit v1.17.0 wählt NICHT der Agent sein Modell, sondern der
# MODEL_ROUTER (docs/LLM_ROUTING.md). Diese Werte sind nur Registry-Defaults /
# Seed-Werte — die Agenten-Laufzeit (`src/cycle/ports.ts`) routet ausschliesslich
# über die versionierte Policy. Modell-Klassen: MODEL_A (lokal klein),
# MODEL_B (lokal mittel), MODEL_C (gross/Cloud), FALLBACK (Regel-Engine).

# Variante A — Solo-Node (N150, 16 GB, CPU)
MODEL_CEO=qwen2.5:3b-instruct-q4_K_M
MODEL_RESEARCH=qwen2.5:3b-instruct-q4_K_M
MODEL_BACKTEST=qwen2.5:3b-instruct-q4_K_M
MODEL_RISK=qwen2.5:3b-instruct-q4_K_M
MODEL_APPROVER=qwen2.5:3b-instruct-q4_K_M
MODEL_EXECUTOR=qwen2.5:1.5b-instruct-q4_K_M

# Analysten-Rollen (nicht handelsberechtigt)
MODEL_TECHNICAL=qwen2.5:3b-instruct-q4_K_M
MODEL_MACRO=qwen2.5:3b-instruct-q4_K_M
MODEL_NEWS=qwen2.5:3b-instruct-q4_K_M
MODEL_SWING=qwen2.5:3b-instruct-q4_K_M
MODEL_SCOUT=qwen2.5:3b-instruct-q4_K_M
MODEL_DILIGENCE=qwen2.5:3b-instruct-q4_K_M

# Variante B — Split-Node (Desktop, 48 GB)
# MODEL_CEO=qwen2.5:14b-instruct-q4_K_M
# MODEL_RESEARCH=qwen2.5:7b-instruct-q4_K_M
# MODEL_BACKTEST=qwen2.5-coder:7b
# MODEL_RISK=qwen2.5:7b-instruct-q4_K_M
# MODEL_APPROVER=qwen2.5:7b-instruct-q4_K_M
# MODEL_EXECUTOR=qwen2.5:7b-instruct-q4_K_M


# --- Broker (noch nicht aktiv, für spätere Tests) --------------------------
# Siehe docs/HANDBUCH.md, Kapitel 8. Standard ist der interne Paper-Broker.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Sicherheit / RBAC (Task 10, gehärtet in C1/v1.36.13) ────
# Rollen: viewer < operator < admin.
# FIRM_ADMIN_TOKEN  → Header x-admin-token (oder x-firm-token mit gleichem Wert)
# FIRM_API_TOKEN    → Header x-firm-token (Operator; ohne Admin-Token = Single-Admin)
# FIRM_VIEWER_TOKEN → Header x-viewer-token (nur Lesen)
# GET /api/auth/me liefert Rolle + Permissions + Auth-Modus, niemals Token-Werte.
# FIRM_ADMIN_TOKEN=
# FIRM_API_TOKEN=bitte-langen-zufalls-token-einsetzen
# FIRM_VIEWER_TOKEN=
#
# AUTH_MODE — offen oder zu, explizit entschieden (kein impliziter Offen-Betrieb):
#   token-required  nur mit Credential schreiben (gilt automatisch, sobald EIN
#                   Token gesetzt ist — Tokens schlagen Offen-Betrieb)
#   local-open      Schreib-API ohne Token; DEV-KOMFORT. Automatisch nur, wenn
#                   kein Token gesetzt ist UND NODE_ENV != production. In
#                   Produktion (npm run start / systemd) ist das ein bewusster,
#                   hier eingetragener Opt-in mit lauter Boot-Warnung.
#   anderer Wert    Boot-Fehler AUTH_MODE_INVALID (fail-closed, Tipfehler != offen)
# PRODUKTION OHNE TOKEN STARTET NICHT: NODE_ENV=production + kein Token =>
# ConfigurationError AUTH_NOT_CONFIGURED, der Start bricht mit Exit-Code 1 ab
# (Wächter scripts/auth-boot-guard.ts, vorgeschaltet bei npm run start/dev;
# Zweitlinie: src/instrumentation.ts). Vor dem Deploy prüfen: npm run boot:guard
# Token erzeugen: openssl rand -hex 32
# AUTH_MODE=local-open
#
# Schreib-Rate-Limit (Anfragen / 60 s, 0 = aus). Standard 60.
# FIRM_RATE_LIMIT=60
#
# TRUSTED_PROXY_IPS — Rate-Limit-Identitaet hinter einem Reverse Proxy (C2, v1.36.14).
#   Ohne dieses Flag zaehlen x-forwarded-for / x-real-ip NICHT: Der Client setzt
#   beide selbst, ein frischer Wert pro Anfrage wuerde das Limit abschalten.
#   Bucket ist dann die Socket-Adresse bzw. die Konstante "local" (alle Clients
#   teilen sich EIN Limit — enger, nie weiter).
#   Mit diesem Flag (CIDR-Liste, Komma/Leerzeichen getrennt) gilt:
#     x-verified-ip        wird uebernommen, wenn der Peer vertrauenswuerdig ist
#                          (oder die Socket-Adresse nicht sichtbar ist, z. B. Next.js)
#     x-forwarded-for      wird NUR uebernommen, wenn die Socket-Adresse des
#                          direkten Peers in der Liste liegt (rightmost-untrusted)
#   Der Reverse Proxy MUSS x-verified-ip selbst setzen und einen vom Client
#   mitgebrachten Wert ueberschreiben, z. B. nginx:
#     proxy_set_header X-Verified-IP $remote_addr;
#   Aliase: loopback | private | link-local. Beispiel (Proxy auf demselben Host):
# TRUSTED_PROXY_IPS=127.0.0.1
# TRUSTED_PROXY_IPS=203.0.113.7,198.51.100.0/24

# ─── Broker Control Plane (Task 08) ─────────────────────────
# AES-256-GCM-Schluessel fuer den verschluesselten Broker-Secret-Store
# (AAD = Venue-ID). Erzeugen: openssl rand -hex 32  (oder Base64, 32 Bytes).
# NIE committen, NIE ins Frontend. Fehlt er, liefern die Credential-
# Endpoints 503 SECRET_STORE_UNAVAILABLE (fail-closed, kein Klartext-Fallback).
# SECRET_STORE_KEY=
#
# KMS-Hook (vorbereitet): Ist ein Endpoint gesetzt, bricht der Store mit
# KMS_NOT_IMPLEMENTED ab (TODO), statt still auf Env zu fallen.
# SECRET_STORE_KMS_ENDPOINT=
#
# Backend des Secret-Stores: db (Default; Fallback file) | file | memory (nur Tests).
# BROKER_SECRET_BACKEND=db
# BROKER_SECRET_DIR=data/secrets
#
# Backend des Control-Plane-ZUSTANDS (C4, v1.36.16): Tabelle venue_control_state
# ist die Wahrheit, die Prozess-Map nur Cache — nach einem Neustart zeigt der
# Broker-Tab den letzten bekannten Verbindungszustand statt INITIAL.
# db (Default; ohne erreichbare Tabelle Fallback memory + Log-Warnung) | memory (nur Tests).
# CONTROL_STATE_BACKEND=db
#
# Admin-Token der Control Plane (RBAC, Task 10): Gesetzt verlangen
# Credential-/Connection-Endpoints Permission broker.credentials
# (Header x-admin-token oder x-firm-token mit gleichem Wert), sonst 403.
# CSRF-Header x-csrf-token = Wert dieses Tokens. Unset = Operator erbt
# Admin-Rechte (Single-Admin), sonst offener Lokalbetrieb.
# FIRM_ADMIN_TOKEN=
#
# Rate-Limit fuer Credential-Versuche (pro Minute und Client-Identitaet,
# 0 = aus). Standard 5. Die Identitaet kommt aus TRUSTED_PROXY_IPS bzw.
# x-verified-ip (siehe oben) — nicht mehr aus spoofbaren Headern (C2, v1.36.14).
# BROKER_CREDENTIAL_RATE_LIMIT=5
#
# Globales Credential-Limit (C2, v1.36.14): Deckel ueber ALLE Clients, bewusst
# IP-unabhaengig — bremst verteiltes Raten (Proxy-Wechsel, NAT, Botnet).
# 0 = aus. Betrifft nur Credential-Endpoints, NIE den Kill-Switch. Standard 20.
# BROKER_CREDENTIAL_GLOBAL_RATE_LIMIT=20
#
# Zusaetzlich aktiv: exponentieller Backoff ab dem 3. fehlgeschlagenen
# Credential-Versuch — 2 s, 4 s, 8 s, ... max. 15 min, Ruecksetzung nach 15 min
# Ruhe oder nach einem von der Venue akzeptierten Credential.
# Zustandskonflikte (409) und Store-Stoerungen (5xx) zaehlen nicht.
# Justierbar (Basis 0 = Backoff aus, wie bei den Limits oben):
# BROKER_CREDENTIAL_BACKOFF_BASE_MS=2000
# BROKER_CREDENTIAL_BACKOFF_MAX_MS=900000

# ─── Broker (Task 02: Capability-Modell) ─────────────────────
# Remote-Health-Checks der Broker (read-only Public-Endpunkte,
# credential-frei). DEFAULT OFF — ohne diese Variable bleibt der
# Health-Check (GET /api/brokers/{venue}/health) vollständig lokal.
# Nur setzen, wenn die read-only Fernprüfung gewünscht ist.
# BROKER_HEALTHCHECK_REMOTE=false

# ─── Bitunix Futures (Task 07) ────────────────────────────────
# Adapter/Market-Data. Nur exakt "true" schaltet an. Default: aus.
# BITUNIX_ENABLED=false
# Venue-Live-Flag — allein wirkungslos. Seit Task 11 entscheidet die
# Live-Gate-State-Machine (docs/LIVE_TRADING.md): Flags sind nur EINE
# von mehreren Bedingungen (State, Suite-Stamp, Control Plane, kein Kill).
# BITUNIX_LIVE_ENABLED=false
# LIVE_TRADING_ENABLED=false
# Secrets: nur Env-Fallback (TODO task-08 SecretStore). Niemals ins Frontend.
# BITUNIX_API_KEY=
# BITUNIX_API_SECRET=
# Test-Overrides (lokaler Mock). Produktion bleibt auf fapi.bitunix.com.
# BITUNIX_BASE_URL=
# BITUNIX_WS_URL=
# BITUNIX_ALLOW_INSECURE_HTTP=false
# BITUNIX_ALLOWED_HOSTS=
# BITUNIX_TIMEOUT_MS=8000
# BITUNIX_RETRY_MAX=3

# ─── Market-Data-Sync (MDSYNC-001) ───────────────────────────
# Persistenter Warmup (Discovery/Enrichment/Backfill) vor dem Scan:
#   npm run market:sync -- --dry-run
# Globaler Kill-Switch — NUR der exakte Wert "false" schaltet ab. Default: an.
# MARKET_SYNC_ENABLED=true
# Venue-Allowlist (kommagetrennt, Großbuchstaben). Leer = alle bekannten Venues,
# die ihr eigenes Flag eingeschaltet hat (z. B. BITUNIX_ENABLED=true).
# MARKET_SYNC_VENUES=BITUNIX
# Public-Endpunkte bleiben auch ohne Secrets erreichbar: der Sync instanziiert
# ausschließlich den credential-freien PublicClient (kein PrivateClient, keine
# API-Keys im Pfad) — und nur, wenn capabilities.<VENUE>.marketData=true UND
# <VENUE>_ENABLED=true gelten.

# ─── Live-Trading-Gate (Task 11) ──────────────────────────────
# DIE zentrale Live-Freischaltung als State-Machine (9 Zustaende, 8 legale
# Uebergaege, auditiert). WICHTIG: Dieser Task AKTIVIERT KEIN LIVE —
# nach dem Merge bleibt Live OFF (Flags false, kein State-File, kein
# Suite-Stamp). Details + Runbook: docs/LIVE_TRADING.md
#
# Ablage der Machine (State-Files, Audit-Hash-Kette, Kill-Failsafe-Datei,
# Security-Suite-Stamp). Default data/live-gate (gitignored).
# LIVE_GATE_DATA_DIR=data/live-gate
#
# Cooldown zwischen LIVE_PENDING und HUMAN_APPROVED (Default 24 h).
# LIVE_GATE_COOLDOWN_MS=86400000
#
# 4-Augen-Modus: zweite, UNTERSCHIEDLICHE Admin-Bestätigung fuer das
# Human-Gate (Default aus).
# LIVE_GATE_FOUR_EYES=false
#
# Paper-Kriterien fuer PAPER_APPROVED: min. Anzahl fehlerfreier Paper-Orders.
# LIVE_GATE_PAPER_MIN_ORDERS=50
#
# Max-Alter des Security-Suite-Stamps (CI-Artefakt); 0 = unbegrenzt.
# LIVE_GATE_SUITE_MAX_AGE_MS=604800000

# ─── Analysten / Scheduler ───────────────────────────────────
# ANALYST_INTERVAL_MIN=30        # Zyklus der Intraday-Analysten
# PENNY_RUN_HOUR_BERLIN=23       # Stunde (Europe/Berlin) für Penny/Swing nach US-Schluss
# TICK_INTERVAL_MS=60000         # Monitor-Zyklus (Minimum 15 s)
# SCHEDULER_ENABLED=true         # false = Scheduler komplett aus

# ─── Makro-/Mikro-Zyklen (v1.6: Event-Driven, getrennte Ebenen) ──
# MAKRO (CEO+Research, LLM im Hintergrund): erzeugt das Regelwerk in
# trade_rules. Takt: 1× stündlich (10–1440 min).
# MACRO_CYCLE_INTERVAL_MIN=60
#
# MIKRO (Ausführung OHNE LLM): eigener Prozess → `npm run micro` bzw.
# systemd-Unit deploy/micro-executor.service. Er lauscht auf WebSocket-
# Preis-Updates und wertet die aktiven Regeln im RAM aus.
# MICRO_SYMBOLS=BTC,ETH            # Symbole für den Feed (Krypto-Whitelist)
# MICRO_FEED=binance               # binance | sim (Offline-Demo, deterministisch)
# MICRO_RULE_REFRESH_MS=30000      # Cache-Reload der aktiven Regeln (5 s – 10 min)
# MICRO_SEED_CANDLES=true          # REST-Historie beim Start laden (warme Indikatoren)
# MICRO_SIM_INTERVAL_MS=250        # Tick-Rate des Simulator-Feeds
# MICRO_HEALTH_PORT=3380           # Health-Endpunkt des Executor-Prozesses

# ─── Paper-Market-Data (Task 03) ─────────────────────────────
# Paper-Modus: synthetic | broker-market-data (Default) | broker-paper-api.
# Default = echte Kurse (Broker-Feed → Binance/Yahoo) mit lokaler Simulation.
# PAPER_MODE=broker-market-data
#
# Statisches Preisbuch NUR als expliziter Offline-Fallback (Default aus).
# PAPER_STATIC_FALLBACK=false
# Synthetic als Failover erlauben (Default aus — nur explizit).
# PAPER_ALLOW_SYNTHETIC_FALLBACK=false
# Modus C (broker-paper-api): nur mit Venue-Capability + diesem Flag.
# PAPER_MODE_C_ENABLED=false
# PAPER_BROKER_API_VENUE=ALPACA
#
# Simulator (deterministisch; Parameter-Tabelle in docs/PAPER_TRADING.md):
# PAPER_SIM_LATENCY_MS=25
# PAPER_SIM_SLIPPAGE_BPS_BASE=1
# PAPER_SIM_SLIPPAGE_PER_PARTICIPATION=30
# PAPER_SIM_SLIPPAGE_JITTER_BPS=0
# PAPER_SIM_PARTIAL_FILL=false
# PAPER_SIM_PARTIAL_MAX_FRACTION=1
# PAPER_SIM_SEED=0
# PAPER_SIM_SYNTHETIC_SPREAD_BPS=2   # Bid/Ask-Spread fuer ticker-basierte Paper-Fills (z. B. Bitunix Modus B)
#
# Normalisierung / Feeds:
# PAPER_ANOMALY_MAX_JUMP_PCT=50     # max. Kurssprung zwischen Kursen in %
# PAPER_STALE_AFTER_MS=30000        # max. Kursalter
# PAPER_FEED_TIMEOUT_MS=8000        # Feed-Timeout
# PAPER_FEED_RETRY_MAX=2            # Feed-Retry-Maximum (inkl. Erstversuch)
# PAPER_FEED_ALLOWED_HOSTS=         # zusätzliche erlaubte Feed-Hosts (SSRF)
# PAPER_HISTORY_DIR=data/history    # append-only Historical Store
