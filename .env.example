# ---------------------------------------------------------------------------
# Autonome KI-Trading-Firma — Konfiguration
#
# Kopieren mit:  cp .env.example .env
# Danach anpassen. Die Datei enthält Zugangsdaten → chmod 600 .env
# ---------------------------------------------------------------------------

# --- Datenbank (Pflicht) ---------------------------------------------------
DATABASE_URL=postgresql://trader:bitte-hier-aendern@127.0.0.1:5432/trading_firm


# --- Modellserver ----------------------------------------------------------
# LLM_PROVIDER = ollama   → nativer Ollama-Server (Standard)
#              = openai   → jeder OpenAI-kompatible Endpunkt:
#                           llama.cpp llama-server, LM Studio, vLLM, LocalAI
#                           oder ein Cloud-Anbieter (ChatGPT/OpenAI, DeepSeek …)
#              = gemini   → Google Gemini (GEMINI_API_KEY nötig)
#              = anthropic→ Anthropic Claude (ANTHROPIC_API_KEY nötig)
#
# Fallback-Kette: LLM_FALLBACK_PROVIDERS=gemini,anthropic versucht bei Ausfall
# des primären Providers die nächsten Provider der Liste (kommagetrennt).
LLM_PROVIDER=ollama
# LLM_FALLBACK_PROVIDERS=

# Variante A (Solo-Node, alles auf dem N150):
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Variante B (Split-Node, Modelle auf dem Desktop) — IP anpassen:
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# Variante B mit RX 480 über Vulkan (llama.cpp llama-server):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://192.168.1.50:8080/v1
# LLM_MODEL=qwen-local
# LLM_API_KEY=

# Cloud-Provider (optional, nur wenn du bewusst Cloud-Kosten willst):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza…
# LLM_MODEL=gemini-2.0-flash
# --- oder ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-…
# LLM_MODEL=claude-3-5-haiku-latest

# Kontextfenster. Größer = mehr Kontext, aber mehr RAM und langsamer.
# Variante A: 4096   ·   Variante B: 8192
OLLAMA_NUM_CTX=4096

# Max. Ausgabetokens pro Agenten-Aufruf (Kosten-/Performance-Hebel):
# klein = schneller & billiger, zu klein = abgeschnittene Antworten.
LLM_MAX_TOKENS=512

# Zeitlimit pro Modellantwort. Auf dem N150 großzügig wählen — sonst greift
# unnötig oft die Regel-Engine.
LLM_TIMEOUT_MS=180000

# Retries: Anzahl Versuche pro Provider bei Netzwerkfehler/429/5xx (1–5).
# 2 = ein Wiederholungsversuch (Standard), 1 = kein Retry (schnellster Betrieb).
LLM_MAX_ATTEMPTS=2

# Kosten-Schätzung fürs Dashboard/Log (USD je 1 Mio. Token; nur für Cloud).
# Lokale Provider (ollama) kosten immer 0. Defaults siehe docs/PROVIDER_INTEGRATION.md.
# LLM_COST_OPENAI_INPUT_PER_MTOK=0.15
# LLM_COST_OPENAI_OUTPUT_PER_MTOK=0.60
# LLM_COST_GEMINI_INPUT_PER_MTOK=0.125
# LLM_COST_GEMINI_OUTPUT_PER_MTOK=0.50
# LLM_COST_ANTHROPIC_INPUT_PER_MTOK=0.80
# LLM_COST_ANTHROPIC_OUTPUT_PER_MTOK=4.00

# --- Model Router (Task 09) ---------------------------------------------------
# Der MODEL_ROUTER entscheidet Modellklasse/Provider/Modell — KEIN Agent selbst.
# Details: docs/LLM_ROUTING.md
#
# Eigene Routing-Policy (JSON). Ungültige Policy => Startverweigerung.
# ROUTING_POLICY_PATH=/etc/ai-trading-firm/routing-policy.json
#
# Health-Poller: Intervall in ms (0 = aus). Default aus der Policy (60000).
# ROUTING_HEALTH_POLL_MS=60000
#
# Prüfumfang: off | local (Default; nur lokale Provider remote) | all (auch Cloud).
# ROUTING_HEALTH_PROBE=local
# ROUTING_HEALTH_TIMEOUT_MS=1500
#
# Tages-Token-Deckel je Provider (Überschreitung => Zwangsfallback auf lokal).
# Cloud-Provider MÜSSEN gedeckelt sein (nie unbegrenzt).
# ROUTING_BUDGET_OLLAMA_TOKENS=5000000
# ROUTING_BUDGET_OPENAI_TOKENS=500000
# ROUTING_BUDGET_GEMINI_TOKENS=200000
# ROUTING_BUDGET_ANTHROPIC_TOKENS=100000
#
# Admin-Token für PUT /api/routing/modes (Policy-Änderungen, auditiert).
# FIRM_ADMIN_TOKEN=


# --- Handelsbetrieb --------------------------------------------------------
# Startkapital des Paper-Kontos in Kontowährung.
STARTING_EQUITY=10000

# true  = kein Agent führt selbst aus; jeder Trade landet als PENDING in
#         'proposals' und muss von Hand freigegeben werden.
#         Empfohlen für die ersten Wochen.
# false = die Pipeline führt freigegebene Trades selbst aus (Paper).
REQUIRE_HUMAN_APPROVAL=false


# --- Modelle je Rolle ------------------------------------------------------
# Werden nur beim ERSTEN Seed verwendet. Später über die Datenbank ändern:
#   UPDATE agents SET model='…' WHERE role='CEO';
#
# ACHTUNG (Task 09): Seit v1.17.0 wählt NICHT der Agent sein Modell, sondern der
# MODEL_ROUTER (docs/LLM_ROUTING.md). Diese Werte sind nur Registry-Defaults /
# Seed-Werte — die Agenten-Laufzeit (`src/cycle/ports.ts`) routet ausschliesslich
# über die versionierte Policy. Modell-Klassen: MODEL_A (lokal klein),
# MODEL_B (lokal mittel), MODEL_C (gross/Cloud), FALLBACK (Regel-Engine).

# Variante A — Solo-Node (N150, 16 GB, CPU)
MODEL_CEO=qwen2.5:3b-instruct-q4_K_M
MODEL_RESEARCH=qwen2.5:3b-instruct-q4_K_M
MODEL_BACKTEST=qwen2.5:3b-instruct-q4_K_M
MODEL_RISK=qwen2.5:3b-instruct-q4_K_M
MODEL_APPROVER=qwen2.5:3b-instruct-q4_K_M
MODEL_EXECUTOR=qwen2.5:1.5b-instruct-q4_K_M

# Analysten-Rollen (nicht handelsberechtigt)
MODEL_TECHNICAL=qwen2.5:3b-instruct-q4_K_M
MODEL_MACRO=qwen2.5:3b-instruct-q4_K_M
MODEL_NEWS=qwen2.5:3b-instruct-q4_K_M
MODEL_SWING=qwen2.5:3b-instruct-q4_K_M
MODEL_SCOUT=qwen2.5:3b-instruct-q4_K_M
MODEL_DILIGENCE=qwen2.5:3b-instruct-q4_K_M

# Variante B — Split-Node (Desktop, 48 GB)
# MODEL_CEO=qwen2.5:14b-instruct-q4_K_M
# MODEL_RESEARCH=qwen2.5:7b-instruct-q4_K_M
# MODEL_BACKTEST=qwen2.5-coder:7b
# MODEL_RISK=qwen2.5:7b-instruct-q4_K_M
# MODEL_APPROVER=qwen2.5:7b-instruct-q4_K_M
# MODEL_EXECUTOR=qwen2.5:7b-instruct-q4_K_M


# --- Broker (noch nicht aktiv, für spätere Tests) --------------------------
# Siehe docs/HANDBUCH.md, Kapitel 8. Standard ist der interne Paper-Broker.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Sicherheit / RBAC (Task 10, gehärtet in C1/v1.36.13) ────
# Rollen: viewer < operator < admin.
# FIRM_ADMIN_TOKEN  → Header x-admin-token (oder x-firm-token mit gleichem Wert)
# FIRM_API_TOKEN    → Header x-firm-token (Operator; ohne Admin-Token = Single-Admin)
# FIRM_VIEWER_TOKEN → Header x-viewer-token (sensible Dashboard-Reads mit firm.read)
# SEC-02: /api/firm, /api/firm/log, /api/firm/report, /api/firm/rules,
# /api/providers und /api/routing verlangen im Token-Betrieb firm.read.
# SEC-06: Operator darf Drafts anlegen/versionieren, pausieren und ablehnen
# (strategy.rules.write). Aktivieren/Rollback/Archivieren und manueller
# Makro-Start verlangen Admin-Permissions (strategy.rules.activate/rollback/archive).
# Echte Rollentrennung braucht VERSCHIEDENE Admin-/Operator-Tokens; ohne
# FIRM_ADMIN_TOKEN bleibt der Operator bewusst Single-Admin.
# Interner Makro-Scheduler: REQUIRE_HUMAN_APPROVAL steuert Autoaktivierung weiter.
# GET /api/auth/me liefert Rolle + Permissions + Auth-Modus, niemals Token-Werte.
# FIRM_ADMIN_TOKEN=
# FIRM_API_TOKEN=bitte-langen-zufalls-token-einsetzen
# FIRM_VIEWER_TOKEN=
#
# SEC-01 (v1.36.27): unabhaengiger serverseitiger Session-Signierschluessel.
# Pflicht in Produktion mit Tokens; auch Dev-Sessions brauchen diesen Key.
# Separat erzeugen: openssl rand -hex 32 (mindestens 32 Zeichen).
# NIEMALS einen Login-Token oder eine Ableitung davon verwenden; kein Fallback.
# Leer/ungueltig => Login 503 SESSION_SECRET_REQUIRED/SESSION_SECRET_INVALID;
# Produktion verweigert zusaetzlich den Start. local-open stellt keine Sessions aus.
# Rotation von Key/Auth-Tokens invalidiert Sessions nach Konfigurations-Neustart.
# Upgrade auf v1.36.27: alte Cookies verfallen, alle Instanzen neu starten/anmelden.
# FIRM_SESSION_SECRET=
#
# Sitzungsdauer und Verlaengerung (v1.39.0, S1) — sitzungsdauer der Browser-
# Session, nicht des Tokens. Der Browser traegt firm_session/firm_csrf OHNE
# Max-Age: die Cookies enden mit dem Schliessen des Fensters. Autorisiert wird
# ueber zwei Fristen im signierten Payload, nicht ueber das Cookie-Alter:
#   FIRM_SESSION_IDLE_TTL_S  Frist ohne Lebenszeichen (Default 900 s, 60 …
#                            86400). Das Dashboard verlaengert sie automatisch
#                            ueber POST /api/auth/refresh — Double-Submit-Header
#                            x-csrf-token ist Pflicht, der API-Token allein gilt
#                            hier bewusst NICHT als Nachweis.
#   FIRM_SESSION_MAX_LIFE_S  absolute Grenze ab Anmeldung (Default 86400 s =
#                            24 h, 600 s … 7 Tage, >= Idle). Verlaengerungen
#                            verschieben sie NIE; danach muss der Token erneut
#                            eingetragen werden (401 SESSION_MAX_LIFE_REACHED).
#   FIRM_SESSION_GRACE_S     Nachfrist (Default 900 s, 0 = aus), in der NUR
#                            POST /api/auth/refresh eine abgelaufene Idle-Frist
#                            heilt — Notebook-Schlaf, gesperrter Screen,
#                            gedrosseltes Tab. Fuer Guard-Routen ist sie
#                            unwirksam, eine abgelaufene Sitzung oeffnet also
#                            keine einzige Schreibroute.
#   SESSION_RENEW_WINDOW_S   Restzeit, unterhalb derer refresh neue Cookies
#                            ausstellt (Default min(300, Idle/2), 10 s … Idle/2).
# 0 oder unbrauchbare Werte fallen auf den Default zurueck — "0" bedeutet NIE
# "unbegrenzt". GET /api/auth/status ist oeffentlich und secret-frei (nur
# Booleans + Restzeiten) und zeigt im Dashboard, ob ein Firm-Token eingetragen
# ist und wie lange die eigene Sitzung laeuft.
# Sicherheitsabwaegung: laengere Lebensdauer = laengere Missbrauchsfrist, falls
# das Cookie selbst abfliesst. Gegenmittel: maxExp als harte Kante,
# POST /api/auth/logout (Admin: Body {"all": true} als Notfallschnitt) und
# Rotation von FIRM_SESSION_SECRET — letzeres entwertet alle Sitzungen sofort.
# Details: CONFIGURATION.md, Abschnitt "Sitzungsdauer und Verlaengerung".
# FIRM_SESSION_IDLE_TTL_S=900
# FIRM_SESSION_MAX_LIFE_S=86400
# FIRM_SESSION_GRACE_S=900
# SESSION_RENEW_WINDOW_S=300
#
# AUTH_MODE — offen oder zu, explizit entschieden (kein impliziter Offen-Betrieb):
#   token-required  nur mit Credential schreiben (gilt automatisch, sobald EIN
#                   Token gesetzt ist — Tokens schlagen Offen-Betrieb)
#   local-open      Schreib-API ohne Token; DEV-KOMFORT. Automatisch nur, wenn
#                   kein Token gesetzt ist UND NODE_ENV != production. In
#                   Produktion (npm run start / systemd) ist das ein bewusster,
#                   hier eingetragener Opt-in mit lauter Boot-Warnung.
#   anderer Wert    Boot-Fehler AUTH_MODE_INVALID (fail-closed, Tipfehler != offen)
# PRODUKTION OHNE TOKEN STARTET NICHT: NODE_ENV=production + kein Token =>
# ConfigurationError AUTH_NOT_CONFIGURED, der Start bricht mit Exit-Code 1 ab
# (Wächter scripts/auth-boot-guard.ts, vorgeschaltet bei npm run start/dev;
# Zweitlinie: src/instrumentation.ts). Vor dem Deploy prüfen: npm run boot:guard
# Token erzeugen: openssl rand -hex 32
# AUTH_MODE=local-open
#
# Schreib-Rate-Limit (Anfragen / 60 s, 0 = aus). Standard 60.
# FIRM_RATE_LIMIT=60
#
# TRUSTED_PROXY_IPS — Rate-Limit-Identitaet hinter einem Reverse Proxy (C2, v1.36.14).
#   Ohne dieses Flag zaehlen x-forwarded-for / x-real-ip NICHT: Der Client setzt
#   beide selbst, ein frischer Wert pro Anfrage wuerde das Limit abschalten.
#   Bucket ist dann die Socket-Adresse bzw. die Konstante "local" (alle Clients
#   teilen sich EIN Limit — enger, nie weiter).
#   Mit diesem Flag (CIDR-Liste, Komma/Leerzeichen getrennt) gilt:
#     x-verified-ip        wird uebernommen, wenn der Peer vertrauenswuerdig ist
#                          (oder die Socket-Adresse nicht sichtbar ist, z. B. Next.js)
#     x-forwarded-for      wird NUR uebernommen, wenn die Socket-Adresse des
#                          direkten Peers in der Liste liegt (rightmost-untrusted)
#   Der Reverse Proxy MUSS x-verified-ip selbst setzen und einen vom Client
#   mitgebrachten Wert ueberschreiben, z. B. nginx:
#     proxy_set_header X-Verified-IP $remote_addr;
#   Aliase: loopback | private | link-local. Beispiel (Proxy auf demselben Host):
# TRUSTED_PROXY_IPS=127.0.0.1
# TRUSTED_PROXY_IPS=203.0.113.7,198.51.100.0/24

# ─── Broker Control Plane (Task 08) ─────────────────────────
# AES-256-GCM-Schluessel fuer den verschluesselten Broker-Secret-Store
# (AAD = Venue-ID). Erzeugen: openssl rand -hex 32  (oder Base64, 32 Bytes).
# NIE committen, NIE ins Frontend. Fehlt er, liefern die Credential-
# Endpoints 503 SECRET_STORE_UNAVAILABLE (fail-closed, kein Klartext-Fallback).
# SECRET_STORE_KEY=
#
# KMS-Hook (vorbereitet): Ist ein Endpoint gesetzt, bricht der Store mit
# KMS_NOT_IMPLEMENTED ab (TODO), statt still auf Env zu fallen.
# SECRET_STORE_KMS_ENDPOINT=
#
# Backend des Secret-Stores: db (Default; Fallback file) | file | memory (nur Tests).
# BROKER_SECRET_BACKEND=db
# BROKER_SECRET_DIR=data/secrets
#
# Audit-Zuverlässigkeit (S1, v1.36.18): sicherheitsrelevante Audits (Auth,
# Kill-Switch, Credentials, Order-Ablehnungen, Freigaben, Prompt-Änderungen)
# werden NICHT mehr best-effort entsorgt. Scheitert audit_log, retryt die Senke
# und legt den Beleg persistent in den Spool (at-least-once, Nachzug beim
# nächsten erfolgreichen Schreibvorgang und beim Boot).
# Ablageverzeichnis des Spools (relativ zum Projektstamm oder absolut):
#   data/audit-spool/audit-pending.ndjson     — offene Nachzüge
#   data/audit-spool/audit-quarantine.ndjson  — von der DB abgelehnte Zeilen
# AUDIT_SPOOL_DIR=data/audit-spool
# Zusätzliche Versuche je security-Audit (0 = kein Retry, Default 2):
# AUDIT_RETRY_MAX=2
# Basis des exponentiellen Backoffs in ms (Default 50 → 50 ms, 100 ms, …):
# AUDIT_RETRY_BASE_MS=50
# Fenster, in dem nach einem DB-Fehlschlag Retries übersprungen werden und der
# Eintrag direkt in den Spool geht (Schutz vor Retry-Lawine im Handelspfad):
# AUDIT_DB_COOLDOWN_MS=2000
#
# Backend des Control-Plane-ZUSTANDS (C4, v1.36.16): Tabelle venue_control_state
# ist die Wahrheit, die Prozess-Map nur Cache — nach einem Neustart zeigt der
# Broker-Tab den letzten bekannten Verbindungszustand statt INITIAL.
# db (Default; ohne erreichbare Tabelle Fallback memory + Log-Warnung) | memory (nur Tests).
# CONTROL_STATE_BACKEND=db
#
# Admin-Token der Control Plane (RBAC, Task 10): Gesetzt verlangen
# Credential-/Connection-Endpoints Permission broker.credentials
# (Header x-admin-token oder x-firm-token mit gleichem Wert), sonst 403.
# CSRF-Header x-csrf-token = Wert dieses Tokens. Unset = Operator erbt
# Admin-Rechte (Single-Admin), sonst offener Lokalbetrieb.
# FIRM_ADMIN_TOKEN=
#
# Rate-Limit fuer Credential-Versuche (pro Minute und Client-Identitaet,
# 0 = aus). Standard 5. Die Identitaet kommt aus TRUSTED_PROXY_IPS bzw.
# x-verified-ip (siehe oben) — nicht mehr aus spoofbaren Headern (C2, v1.36.14).
# BROKER_CREDENTIAL_RATE_LIMIT=5
#
# Globales Credential-Limit (C2, v1.36.14): Deckel ueber ALLE Clients, bewusst
# IP-unabhaengig — bremst verteiltes Raten (Proxy-Wechsel, NAT, Botnet).
# 0 = aus. Betrifft nur Credential-Endpoints, NIE den Kill-Switch. Standard 20.
# BROKER_CREDENTIAL_GLOBAL_RATE_LIMIT=20
#
# Zusaetzlich aktiv: exponentieller Backoff ab dem 3. fehlgeschlagenen
# Credential-Versuch — 2 s, 4 s, 8 s, ... max. 15 min, Ruecksetzung nach 15 min
# Ruhe oder nach einem von der Venue akzeptierten Credential.
# Zustandskonflikte (409) und Store-Stoerungen (5xx) zaehlen nicht.
# Justierbar (Basis 0 = Backoff aus, wie bei den Limits oben):
# BROKER_CREDENTIAL_BACKOFF_BASE_MS=2000
# BROKER_CREDENTIAL_BACKOFF_MAX_MS=900000
#
# Env-Fallback fuer Broker-Credentials (SEC-07, v1.36.32): Nur exakt "true"
# schaltet den Fallback scharf, und NUR wenn NODE_ENV!=production.
# In Produktion immer aus: fehlender Datensatz => null (kein Credential),
# Store-Fehler (AUTH_FAILED, STORAGE_UNAVAILABLE) => HARD FAIL (throw, im
# Control-Plane-Flow als 503 sichtbar). Ohne Flag und ohne SECRET_STORE_KEY
# => fail-closed. Mit Flag in Dev/Test => Env-Fallback erlaubt.
# BROKER_ALLOW_ENV_FALLBACK=false

# ─── Broker (Task 02: Capability-Modell) ─────────────────────
# Remote-Health-Checks der Broker (read-only Public-Endpunkte,
# credential-frei). DEFAULT OFF — ohne diese Variable bleibt der
# Health-Check (GET /api/brokers/{venue}/health) vollständig lokal.
# Nur setzen, wenn die read-only Fernprüfung gewünscht ist.
# BROKER_HEALTHCHECK_REMOTE=false

# ─── Bitunix Futures (Task 07) ────────────────────────────────
# Adapter/Market-Data. Nur exakt "true" schaltet an. Default: aus.
# BITUNIX ist derzeit die EINZIGE produktiv angebundene Sync-Venue:
# ohne Freischaltung laufen `market:sync` und das Setup-Warmup leer
# (VENUE_DISABLED) und der Scanner bleibt dauerhaft WARMING. Lokale
# Installationen schalten daher für Kerzendaten ein (Public-Endpunkte,
# keine API-Keys nötig — das Setup-Skript erledigt das automatisch):
# BITUNIX_ENABLED=true
# Venue-Live-Flag — allein wirkungslos. Seit Task 11 entscheidet die
# Live-Gate-State-Machine (docs/LIVE_TRADING.md): Flags sind nur EINE
# von mehreren Bedingungen (State, Suite-Stamp, Control Plane, kein Kill).
# BITUNIX_LIVE_ENABLED=false
# LIVE_TRADING_ENABLED=false
# Secrets: Default ist der verschluesselte Control-Plane-Store (AES-256-GCM,
# AAD = Venue). Env-Fallback BITUNIX_API_KEY / BITUNIX_API_SECRET nur mit
# BROKER_ALLOW_ENV_FALLBACK=true und NODE_ENV!=production (SEC-07 v1.36.32).
# In Produktion: fehlender Datensatz => null, Store-Fehler => HARD FAIL.
# BITUNIX_API_KEY=
# BITUNIX_API_SECRET=
# Test-Overrides (lokaler Mock). Produktion bleibt auf fapi.bitunix.com.
# BITUNIX_BASE_URL=
# BITUNIX_WS_URL=
# BITUNIX_ALLOW_INSECURE_HTTP=false
# BITUNIX_ALLOWED_HOSTS=
# BITUNIX_TIMEOUT_MS=8000
# BITUNIX_RETRY_MAX=3
# Chunk-Größe für GET /tickers?symbols=… — URL-sichere ~1 KB Queries (v1.39.2).
# Default 50; 750 Symbole → 15 Chunks statt 1× >6 KB-URL (Gateway lehnte ab → 754× SCHEMA_MISMATCH).
# BITUNIX_TICKER_SYMBOLS_PER_REQUEST=50

# ─── Market-Data-Sync (MDSYNC-001) ───────────────────────────
# Persistenter Warmup (Discovery/Enrichment/Backfill) vor dem Scan:
#   npm run market:sync -- --dry-run
# Globaler Kill-Switch — NUR der exakte Wert "false" schaltet ab. Default: an.
# MARKET_SYNC_ENABLED=true
# Venue-Allowlist (kommagetrennt, Großbuchstaben). Leer = alle bekannten Venues,
# die ihr eigenes Flag eingeschaltet hat (z. B. BITUNIX_ENABLED=true).
# MARKET_SYNC_VENUES=BITUNIX
# Public-Endpunkte bleiben auch ohne Secrets erreichbar: der Sync instanziiert
# ausschließlich den credential-freien PublicClient (kein PrivateClient, keine
# API-Keys im Pfad) — und nur, wenn capabilities.<VENUE>.marketData=true UND
# <VENUE>_ENABLED=true gelten.
#
# Seit v1.38.0 läuft der Kerzen-Abruf inkrementell (Reihen mit der Kerze des
# laufenden Zeitraums werden ohne Request übersprungen; --full schaltet das
# ab) und erfolgreiche Orderbuch-Spreads werden TTL-basiert in
# data/spread-cache.json wiederverwendet (Default 6 h). `0` deaktiviert den
# Spread-Cache; die systemd-Units deploy/market-sync*.timer automatisieren
# den stündlichen Inkrementallauf + täglichen Vollabgleich.
# MARKET_SPREAD_CACHE_TTL_MS=21600000

# ─── Datenqualitäts-Layer & Multi-TF (GAP-07, v1.47.0) ───────────
# Qualitätsprüfung der Kerzenserien (GAP/OUTLIER/INVALID/DUPLICATE):
# Befunde sind SICHTBAR klassifiziert (MDERR-Stil) — Report je Instrument
# (data/marketdata/quality-report.json) + Log + Metrik. Gespeicherte
# Historie wird nie still verändert; echte Flash-Moves werden nicht
# weggefiltert. Details: CONFIGURATION.md (Tabelle "Datenqualitäts-Layer"),
# docs/MARKET_DATA_PIPELINE.md §14, docs/OBSERVABILITY.md §2.1.
#
# Lesepfad-Modus: log (Default, nur sichtbar machen) | strict
# (fail-closed: Instrumente mit INVALID-Befund gelten wie DATA_UNAVAILABLE).
# MARKETDATA_QUALITY_MODE=log
# Outlier-Schwelle (Wick/Körper > N x Volatilitaets-Baseline; Default 25,
# Bounds [5, 200] — bewusst grosszuegig, exakt N x Baseline = kein Befund).
# MARKETDATA_OUTLIER_ATR_MULT=25
# Stale-Guard-Schwellen je Timeframe in Stunden (Ausweis als Zaehler im
# Sync-Status data/market-sync-status.json; Bounds siehe CONFIGURATION.md).
# MARKETDATA_STALE_1H_HOURS=26
# MARKETDATA_STALE_4H_HOURS=104
# MARKETDATA_STALE_1D_HOURS=624
#
# Deterministische 1h->4h/1d-Aggregation im Sync-CLI (auch: --aggregate):
# UTC-Anker, unvollstaendige Buckets werden NIE aggregiert, Aggregat wird als
# NEUE Timeframe-Reihe appendet (1h-Quelle bleibt unangetastet). Default off.
# MARKET_SYNC_AGGREGATE=off
#
# Zweitquellen-Cross-Check (Default OFF — Rate-Limits!): nur wirksam, wenn
# der Adapter getCrosscheckCandles() implementiert (Adapter-Registry-Muster).
# Abweichung > Toleranz (in %) => QUALITY_CROSSCHECK-Befund + Log.
# MARKETDATA_CROSSCHECK=off
# MARKETDATA_CROSSCHECK_TOLERANCE_PCT=1

# ─── MTF-Konfluenz (RMA-P2-03, v1.62.0) ───────────────────────
# Deterministischer Multi-Timeframe-Snapshot (mtf-confluence@1) als
# Trusted-Data für technischen Step + Analyst. Defaults: 15m/1h/4h,
# Gewichte 0.2/0.3/0.5, minCoverage 0.5. Details:
# docs/MTF_CONFLUENCE.md, CONFIGURATION.md (§ MTF-Konfluenz).
# CONFLUENCE_ENABLED=true
# CONFLUENCE_CONFIG_FILE=           # Pfad einer JSON-Config (optional)

# Cross-Sectional Momentum Ranking (RMA-P2-04, v1.63.0).
# docs/CROSS_SECTIONAL_RANKING.md, CONFIGURATION.md (§ Cross-Sectional).
# CROSS_SECTIONAL_ENABLED=true      # Scanner-Artefakt-Lesepfad (Rollback: false)
# CROSS_SECTIONAL_CONFIG_FILE=      # Pfad einer JSON-Config (optional)

# ─── Live-Trading-Gate (Task 11) ──────────────────────────────
# DIE zentrale Live-Freischaltung als State-Machine (9 Zustaende, 8 legale
# Uebergaege, auditiert). WICHTIG: Dieser Task AKTIVIERT KEIN LIVE —
# nach dem Merge bleibt Live OFF (Flags false, kein State-File, kein
# Suite-Stamp). Details + Runbook: docs/LIVE_TRADING.md
#
# Ablage der Machine (State-Files, Audit-Hash-Kette, Kill-Failsafe-Datei,
# Security-Suite-Stamp). Default data/live-gate (gitignored).
# LIVE_GATE_DATA_DIR=data/live-gate
#
# Cooldown zwischen LIVE_PENDING und HUMAN_APPROVED (Default 24 h).
# LIVE_GATE_COOLDOWN_MS=86400000
#
# 4-Augen-Modus: zweite, UNTERSCHIEDLICHE Admin-Bestätigung fuer das
# Human-Gate (Default aus).
# LIVE_GATE_FOUR_EYES=false
#
# Paper-Kriterien fuer PAPER_APPROVED: min. Anzahl fehlerfreier Paper-Orders.
# LIVE_GATE_PAPER_MIN_ORDERS=50
#
# Max-Alter des Security-Suite-Stamps (CI-Artefakt); 0 = unbegrenzt.
# LIVE_GATE_SUITE_MAX_AGE_MS=604800000

# ─── Analysten / Scheduler ───────────────────────────────────
# ANALYST_INTERVAL_MIN=30        # Zyklus der Intraday-Analysten
# PENNY_RUN_HOUR_BERLIN=23       # Stunde (Europe/Berlin) für Penny/Swing nach US-Schluss
# TICK_INTERVAL_MS=60000         # Monitor-Zyklus (Minimum 15 s)
# SCHEDULER_ENABLED=true         # false = Scheduler komplett aus

# ─── Makro-/Mikro-Zyklen (v1.6: Event-Driven, getrennte Ebenen) ──
# MAKRO (CEO+Research, LLM im Hintergrund): erzeugt das Regelwerk in
# trade_rules. Takt: 1× stündlich (10–1440 min).
# MACRO_CYCLE_INTERVAL_MIN=60
#
# MIKRO (Ausführung OHNE LLM): eigener Prozess → `npm run micro` bzw.
# systemd-Unit deploy/micro-executor.service. Er lauscht auf WebSocket-
# Preis-Updates und wertet die aktiven Regeln im RAM aus.
# MICRO_SYMBOLS=BTC,ETH            # Symbole für den Feed (Krypto-Whitelist)
# MICRO_FEED=binance               # binance | sim (Offline-Demo, deterministisch)
# MICRO_RULE_REFRESH_MS=30000      # Cache-Reload der aktiven Regeln (5 s – 10 min)
# MICRO_SEED_CANDLES=true          # REST-Historie beim Start laden (warme Indikatoren)
# MICRO_SIM_INTERVAL_MS=250        # Tick-Rate des Simulator-Feeds
# MICRO_HEALTH_PORT=3380           # Health-Endpunkt des Executor-Prozesses

# ─── Paper-Market-Data (Task 03) ─────────────────────────────
# Paper-Modus: synthetic | broker-market-data (Default) | broker-paper-api.
# Default = echte Kurse (Broker-Feed → Binance/Yahoo) mit lokaler Simulation.
# PAPER_MODE=broker-market-data
#
# Statisches Preisbuch NUR als expliziter Offline-Fallback (Default aus).
# PAPER_STATIC_FALLBACK=false
# Synthetic als Failover erlauben (Default aus — nur explizit).
# PAPER_ALLOW_SYNTHETIC_FALLBACK=false
# Modus C (broker-paper-api): nur mit Venue-Capability + diesem Flag.
# PAPER_MODE_C_ENABLED=false
# PAPER_BROKER_API_VENUE=ALPACA
#
# Verzeichnis der Instrumenten-Registry (NDJSON; schreibt das Setup als
# UNIVERSE_DATA_DIR=data/universe). Override nur noetig, wenn die Daten
# ausserhalb des Repo-Defaults liegen sollen.
# UNIVERSE_DATA_DIR=data/universe
#
# Simulator (deterministisch; Parameter-Tabelle in docs/PAPER_TRADING.md):
# PAPER_SIM_LATENCY_MS=25
# PAPER_SIM_SLIPPAGE_BPS_BASE=1
# PAPER_SIM_SLIPPAGE_PER_PARTICIPATION=30
# PAPER_SIM_SLIPPAGE_JITTER_BPS=0
# PAPER_SIM_PARTIAL_FILL=false
# PAPER_SIM_PARTIAL_MAX_FRACTION=1
# PAPER_SIM_SEED=0
# PAPER_SIM_SYNTHETIC_SPREAD_BPS=2   # Bid/Ask-Spread fuer ticker-basierte Paper-Fills (z. B. Bitunix Modus B)
#
# Kalibrierung der Execution-Simulation (GAP-02, v1.42.0; Overlay ueber die
# PAPER_SIM_*-Basis; ungesetzt = Basis bleibt gelten. Bounds mit Log-Warnung):
# PAPER_MAKER_FEE_PCT=0.04           # Maker-Gebuehr in % (0.04 = 4 bp; Bounds [0, 10])
# PAPER_TAKER_FEE_PCT=0.1            # Taker-Gebuehr in % fuer Market-Fills (Bounds [0, 10])
# PAPER_SLIPPAGE_BPS=1               # Basis-Slippage in Basispunkten (Bounds [0, 10000])
# PAPER_SPREAD_FALLBACK_BPS=2        # Spread-Fallback in Basispunkten (Bounds [0, 10000])
#
# Funding-Accrual fuer Perpetual-Positionen (GAP-02, v1.42.0; gebucht im
# Monitor-Tick bei Periodenwechsel; Vorzeichen/Doku: docs/PAPER_TRADING.md 3.2):
# PAPER_FUNDING_INTERVAL_HOURS=8     # Accrual-Takt in h (Bounds [1, 24]; 8 = Marken 00/08/16 UTC)
# PAPER_FUNDING_RATE_PCT_PER_8H=0    # statische Rate je 8h in % (0.01 = 0.01 %/8h; 0 = aus; Bounds [-1, 1])
#                                    # LONG zahlt bei positiver Rate, SHORT erhaelt.
#
# Trade-Journal (GAP-03, v1.43.0): Attributions-Nachvollziehbarkeit +
# begrenzte Gewichts-Rueckfuhrung. Alle Flags optional — ohne jede
# Konfiguration laeuft das System unveraendert (off = nur Auswertung).
# Doku: docs/HANDBUCH.md 20, CONFIGURATION.md (Tabelle "Trade-Journal").
# JOURNAL_FEEDBACK_MODE=off          # off (Default, sicher) | monitor | enforce; unbekannt -> off
# JOURNAL_MIN_TRADES=20              # Mindest-Stichprobe je Agent x Regime (Bounds [5, 200]); darunter = insufzient, nie Faktor
# JOURNAL_WEIGHT_MIN=0.5             # untere Gewichts-Bound (Wert-Bounds [0.1, 1.0])
# JOURNAL_WEIGHT_MAX=1.5             # obere Gewichts-Bound (Wert-Bounds [1.0, 3.0])
# JOURNAL_MAX_WEIGHT_DELTA=0.1       # max. Gewaend. JE Zyklus (Bounds [0.01, 0.5]); Annaeherung, nie Sprung
# JOURNAL_CANDLES_TIMEFRAME=1h       # Kerzen-Intervall fuer MAE/MFE (Luecke -> null + CANDLE_GAP, nie geraet)
#
# Deterministische Trade-PnL-Attribution (RMA-P1-06, v1.57.0): Beim Close
# eines Trades wird append-only persistiert, welche Quellen (Agenten/Regel)
# welchen Beitrag zum Netto-PnL geleistet haben — Quellen + Kosten + Residual
# = Netto, exakt reconciled. Rein additiv: kein Einfluss auf Orders, Risiko
# oder Entscheidungen. Doku: src/attribution/README.md, CONFIGURATION.md.
# TRADE_ATTRIBUTION_ENABLED=true       # false = kein automatischer Close-Attribution-Pfad + Backfill-Sperre
# TRADE_ATTRIBUTION_METHOD_VERSION=1   # implementierte Methoden (Allowlist [1]); Wechsel schreibt NEUE Zeilen
#
# Server-seitiges Exit-Management (GAP-05, v1.44.0): Trailing-Stop und
# Time-Stop im Monitor-Tick, OCO-Exklusivitaet (genau ein Exit je Position,
# auch bei parallelen Ticks/Instanzen — DB-Claim). Alle Flags per Default
# AUS = heutiges Verhalten (nur SL/TP). Doku: docs/PAPER_TRADING.md (Exit-
# Management), CONFIGURATION.md (Tabelle "Exit-Management").
# RISK_TRAILING_ENABLED=false        # Trailing-Stop ueberhaupt (false = aus; kein Verhaltensbruch)
# RISK_TRAILING_ACTIVATION_PCT=1.0   # Bewaffnung ab x % Gewinn je Position (Bounds [0.1, 20])
# RISK_TRAILING_RETURN_PCT=0.5       # erlaubter Rueckgabeweg in % (Stop = Kurs - x %; Bounds [0.1, 10])
# RISK_TIME_STOP_HOURS=0             # max. Haltedauer in h, dann Close (0 = aus; Bounds [0, 720])
#
# Normalisierung / Feeds:
# PAPER_ANOMALY_MAX_JUMP_PCT=50     # max. Kurssprung zwischen Kursen in %
# PAPER_STALE_AFTER_MS=30000        # max. Kursalter
# PAPER_FEED_TIMEOUT_MS=8000        # Feed-Timeout
# PAPER_FEED_RETRY_MAX=2            # Feed-Retry-Maximum (inkl. Erstversuch)
# PAPER_FEED_ALLOWED_HOSTS=         # zusätzliche erlaubte Feed-Hosts (SSRF)
# PAPER_HISTORY_DIR=data/history    # append-only Historical Store

#
# Auto-Circuit-Breaker, Alerts & Heartbeat (GAP-10, v1.45.0):
# Der Brecher prueft im Monitor-Tick drei harte Ausloeser (Drawdown >=
# maxEquityDrawdownPct, Tagesverlust >= dailyLossLimitPct, N Verlust-Closes
# in Folge) und zieht den BESTEHENDEN Kill-Switch mit maschinenlesbarem Grund
# `auto-circuit-breaker:<metrik>:<wert>` + Audit + Alert. Latching: Entschaerfen
# ausschliesslich manuell (Admin-Permission + CSRF + single-use Nonce).
# VERHALTENSAENDERUNG: AUTO_CIRCUIT_BREAKER ist per Default AN.
# Doku: docs/OBSERVABILITY.md 9-12, Runbook docs/OPERATIONS.md 4,
# CONFIGURATION.md (Tabelle "Firmen-Metriken, Auto-Circuit-Breaker, ...").
# AUTO_CIRCUIT_BREAKER=on            # on (Default) | off; unbekannt -> on + Warnung
# RISK_MAX_CONSECUTIVE_LOSSES=5      # Verlust-Closes in Folge (Bounds [2, 50])
# ALERT_DEBOUNCE_MINUTES=30          # mind. Abstand je Alarm-Code (Bounds [1, 1440])
# ALERT_FILE=data/alerts.ndjson      # append-only NDJSON-Senke (Modus 0600)
# ALERT_WEBHOOK_URL_SECRET_NAME=     # Name des Secret-Store-Eintrags, dessen
#                                    # apiKey-Feld die Webhook-URL ist;
#                                    # leer = Webhook aus (Default). Die URL
#                                    # selbst ist ein Credential -> NIE hier eintragen.
# HEALTH_STALE_AFTER_MS=300000       # stale ab Tick-Alter > x ms (Bounds [30000, 3600000])
#
# Watchdog (npm run watchdog, alarm-first, startet/entschaerft nichts):
#   Optionen als CLI: --url=..., --source=inprocess, --timeout-ms=...;
#   Exit 0 = gesund, 1 = Alarm, 2 = Bedienfehler.
#
# Regime-Gate (GAP-06, v1.46.0): deterministischer Markt-Regime-Klassifikator
# (TREND_UP/TREND_DOWN/RANGE/HIGH_VOL/CRASH) + Strategie-Gate als DATENKONTEXT
# (kein Veto). Rollout monitor-first: Default = Ausweis + Audit, keine Wirkung.
# Seit v1.61.0 (RMA-P2-01): multidimensional, point-in-time-sicher —
# versionierte Preis/Vol/Liquiditaet/Perp/Makro-Familien mit Confidence,
# Coverage, Top-Treibern; fehlende/stale Daten degradieren explizit (nie 0).
# Doku: docs/REGIME_GATE.md, CONFIGURATION.md (Tabelle "Regime-Gate").
# REGIME_GATE_MODE=monitor           # off | monitor (Default) | enforce; unbekannt -> monitor
# REGIME_LOOKBACK_CANDLES=100        # Lookback-Fenster der Klassifikation (Bounds [20, 500])
# CRASH_DRAWDOWN_PCT=10              # Drawdown-Schwelle in % fuer CRASH (Bounds [3, 50])
# HIGH_VOL_PERCENTILE=90             # Vol-Perzentil-Schwelle fuer HIGH_VOL (Bounds [50, 99])
# REGIME_CONFIRM_CANDLES=3           # Hysterese: Bestaetigungen bis Regime-Wechsel (Bounds [1, 20])
# REGIME_TREND_ADX=25                # ADX-Schwelle fuer TREND_* (Bounds [10, 60])
# REGIME_TREND_SLOPE_PCT=0.05        # Mindest-|Slope| in %/Kerze fuer TREND_* (Bounds [0.005, 1])
# REGIME_GATE_FACTORS=               # optional: REGIME:klasse=faktor,... z. B.
#                                    # TREND_UP:mean-reversion=0.5,RANGE:breakout=0.5
#                                    # (Werte geklemmt [0, 2]; kaputte Eintraege werden uebersprungen)
# REGIME_FEATURE_MODE=multidim       # multidim (Default) | ohlcv (Legacy-Pfad, unbekannt -> multidim)
# REGIME_MIN_COVERAGE=0.5            # Mindest-Coverage [0,1]; darunter degraded + Gate-Boost blockiert
# REGIME_LIQUIDITY_SPREAD_HIGH_PCT=0.5  # Spread-Vote -> HIGH_VOL (Bounds [0.01, 100])
# REGIME_PERP_FUNDING_ABS=0.001      # |Funding|-Vote -> HIGH_VOL (Bounds [0.00001, 0.1])
# REGIME_MACRO_VIX_HIGH=30           # Makro-VIX-Vote -> HIGH_VOL (Bounds [10, 100])
# REGIME_SNAPSHOT_RETENTION_DAYS=90  # regime_snapshots Retention (Bounds [7, 365])
# PERP_DATA_ENABLED=false            # true aktiviert die Perp-Familie (sonst MISSING, nie 0)
#
# Vol-Sizing + Cluster-Exposure-Guardrail (GAP-04, v1.48.0): Groesse nach
# Volatilität (qty = Risikobudget/Stop-Abstand, ATR-Fallback-Stop) +
# Fractional-Kelly-Deckel + Korrelations-Cluster-Limits im Order-Pfad
# (Guardrail-Schicht 3). Rollout monitor-first: Default = Ausweis + Audit,
# keine Wirkung; Kelly-Deckel per Default AUS. Alle Werte an die Code-
# Ceilings geklemmt (Sizing verschärft, lockert nie). Doku:
# docs/PORTFOLIO_ANALYTICS.md (Sizing & Cluster-Limits), CONFIGURATION.md
# (Tabelle "Sizing & Cluster-Limits"), Ops: docs/HANDBUCH.md §9.
# RISK_ATR_STOP_MULT=2               # ATR-Fallback-Stop = k x ATR, wenn kein expliziter Stop (Bounds [0.5, 6])
# RISK_KELLY_FRACTION=0              # Fractional-Kelly-Deckel (0 = AUS; Deckel wirkt nur mit Journal-Stats; Bounds [0, 1])
# RISK_CLUSTER_LIMITS_MODE=monitor   # monitor (Default: nur Audit-Notiz + Log) | enforce (echte Ablehnung); unbekannt -> monitor
# RISK_CORR_THRESHOLD=0.7            # |rho|-Schwelle fuer die Cluster-Union (Bounds [0.3, 0.99])
# RISK_MAX_PER_CLUSTER=3             # max. offene Positionen je Korrelations-Cluster (Bounds [1, 10])
# RISK_CORR_WINDOW_CANDLES=90        # Renditen-Fenster in 1h-Kerzen (Bounds [30, 365])
# RISK_CORR_CACHE_TTL_MS=900000      # Cache-TTL der Korrelations-Berechnung (Bounds [60000, 3600000])
#                                    # stale Daten (keine/zu alte Kerzen im HistoricalStore) ->
#                                    # enforce lehnt ab: cluster-exposure:correlation-stale (fail-closed)
#
# LLM-Plausibilitaet, Prompt-Eval-Harness & Turn-Budget (GAP-08, v1.49.0):
# Plausibilitaets-Schicht ueber Agenten-Outputs (Monotonie, Preisband um
# Known-Good-Kurse, Confidence/Begruendung, Zahlenbezug), Golden-Dataset-Eval
# (`npm run eval:prompts`, Reports nach data/eval/) und Turn-Hartdeckel
# (Token-Summe + Wall-Clock je Agenten-Turn inkl. Retries). Doku:
# docs/LLM_ROUTING.md (Abschnitt 17), CONFIGURATION.md (Tabelle
# "Plausibilitaet, Eval-Harness & Turn-Budget").
# PLAUSIBILITY_PRICE_BAND_PCT=15    # Preisband um Known-Good-Kurs in % (Bounds [1, 90])
# PLAUSIBILITY_MIN_RATIONALE_CHARS=40  # Mindestbegruendung bei Confidence >= 0.9 (Bounds [0, 1000]; 0 = Regel aus)
# LLM_MAX_TOKENS_PER_TURN=20000     # Token-Summe je Turn inkl. Retries (Bounds [1000, 200000]); Bruch -> sauberer Abbruch + Audit llm-budget:tokens
# LLM_MAX_TURN_MS=120000            # Wall-Clock je Turn in ms (Bounds [10000, 900000]); Bruch -> Abbruch + Audit llm-budget:time
# EVAL_OUTPUT_DIR=data/eval         # Report-Verzeichnis des Eval-Harness (JSON + MD)
#
# Broker ↔ DB Reconciliation & Idempotenz (GAP-09, v1.50.0):
# Periodischer Abgleich Broker-Positionen/Account ↔ DB, Differenz-
# Klassifikation (PRICE_DRIFT, QTY_MISMATCH, PHANTOM_POSITION,
# MISSING_POSITION, BALANCE_MISMATCH, INVARIANT_VIOLATION),
# optionaler Pause-Pfad bei kritischen Diskrepanzen (kein Auto-Flatten)
# und einheitliche Client-Order-IDs ("atf-<intentId-kurz>"). Doku:
# docs/BROKER_ARCHITECTURE.md (§10), CONFIGURATION.md (Tabelle
# "Reconciliation & Idempotenz").
# RECON_PRICE_DRIFT_PCT=1           # Max. Preis-Drift in % fuer tolerierbare Einstufung (PRICE_DRIFT; Bounds [0.01, 10])
# RECON_INTERVAL_MINUTES=60         # Intervall fuer periodischen Abgleich in Minuten (Bounds [5, 1440])
# RECON_PAUSE_ON_MISMATCH=false     # true: Kill-Switch scharfschalten bei kritischen Abweichungen (Default false)
#
# Walk-Forward-Backtesting (GAP-01, v1.51.0):
# Rollierende IS/OOS-Fenster der regelbasierten Backtesting-Engine
# (Paper-Ausfuehrung = derselbe Fill-Simulator wie der PaperBroker).
# IS/OOS trennt EVALUATIONS-Fenster (Robustheit) - keine
# Parameter-Optimierung. CLI: scripts/run-backtest.ts. Doku:
# docs/BACKTESTING.md, CONFIGURATION.md (Tabelle "Walk-Forward-Backtesting").
# WF_IS_WINDOW_DAYS=90              # IS-Fenster in Tagen (Bounds [14, 720])
# WF_OOS_WINDOW_DAYS=30             # OOS-Fenster in Tagen, zugleich Schrittweite (Bounds [7, 180])
# WF_MAX_SPAN_DAYS=730              # Max. Backtest-Zeitraum in Tagen, Default 2 Jahre (Bounds [30, 3650])
#
# Perpetual-Daten (RMA-P2-02, v1.54.0):
# Historische Funding-Raten, Open Interest und Liquidationen in eigenen
# perp_*-Tabellen, as-of-lesbar und append-only. Beide Gates aus = System wie
# vorher. Migration: psql "$DATABASE_URL" -f drizzle/2026-09-20_perpetual_data.sql
# Doku: docs/PERPETUAL_DATA.md, CONFIGURATION.md (Tabelle "Perpetual-Daten").
# PERP_DATA_ENABLED=false             # Konsumenten (Scanner/Replay/Analyst) an/a
# PERP_DATA_SYNC_ENABLED=false        # Netz-Ingestion an/a (ohne sie: 0 Requests)
# PERP_DATA_VENUES=BITUNIX            # Kommaliste; zusaetzlich gilt BITUNIX_ENABLED
# PERP_DATA_AVAILABILITY=ingested     # ingested | settlement (availableAt-Politik)
# PERP_DATA_QUALITY_MODE=log          # log | strict (INVALID/DUPLICATE blockieren)
# PERP_DATA_BACKFILL_DAYS=30          # Erstbefüllung je Reihe (Bounds [1, 400])
# PERP_DATA_FUNDING_INTERVAL_HOURS=8  # erwartetes Funding-Raster (Bounds [1, 24])
# PERP_DATA_OI_INTERVAL_MINUTES=60    # erwartetes OI-Raster (Bounds [1, 1440])
# PERP_DATA_MAX_STALE_FUNDING_HOURS=24 # Frische Funding (Bounds [1, 168])
# PERP_DATA_MAX_STALE_OI_HOURS=4      # Frische Open Interest (Bounds [1, 72])
# PERP_DATA_MAX_ABS_FUNDING_RATE=0.0075 # Plausibilitaets-Bound je Intervall
# PERP_DATA_MAX_OI_CHANGE=0.5         # max. relative OI-Aenderung (Bounds [0.01, 5])
# PERP_DATA_CONCURRENCY=4             # parallele Reihen, hart <= 8
# PERP_DATA_SAFETY_LAG_MS=60000       # Fenster-Nachlauf (Bounds [0, 21600000])
# PERP_DATA_CROSSCHECK_VENUE=          # zweite Venue fuer Funding-Abgleich (opt-in)

# Optional append-only execution-quality capture. Apply all execution_quality SQL
# migrations first; use a stable opaque namespace per broker account/deployment.
EXECUTION_QUALITY_ENABLED=false
EXECUTION_QUALITY_SCOPE=desk-paper-1
