/data/marketdata/quality-report.json
/data/marketdata/*.tmp*
/data/market-data-errors.json.tmp
/data/spread-cache.json
/data/spread-cache.json.tmp

# Sync-Status je Venue (OPS-011): Laufzeit-Artefakt des Sync-Jobs,
# vom Operations Center gelesen — nicht versioniert
/data/market-sync-status.json
/data/market-sync-status.json.tmp

# Model Router (Task 09): Routing-Audit und Modi-Persistenz (Laufzeitdaten)
/data/routing

# Prompt-Eval-Reports (GAP-08, v1.49.0): `npm run eval:prompts` schreibt
# JSON- + MD-Report je Lauf — reproduzierbar, nicht versioniert.
/data/eval

# Reconciliation-Reports (GAP-09, v1.50.0): `scripts/reconcile.ts` schreibt
# last-report.json — Laufzeitdaten, nicht versioniert.
/data/reconciliation

# Walk-Forward-Run-Artefakte (GAP-01, v1.51.0): `scripts/run-backtest.ts`
# schreibt Report-JSON + MD-Zusammenfassung je Lauf — reproduzierbar aus
# Historie + Regel, nicht versioniert (Vergleich via backtest_runs/Read-API).
/data/backtest

# Monte-Carlo-Artefakte (RMA-P6-02, v1.72.0): `scripts/run-montecarlo.ts`
# schreibt Result-JSON + MD-Zusammenfassung je Analyse — reproduzierbar aus
# Seed + Config + Trade-Ledger, nicht versioniert (Vergleich via API).
/data/montecarlo

# Alert-Datei-Sink (GAP-10, v1.45.0; ignoriert seit v1.51.1): der
# AlertDispatcher hängt jeden Alarm als NDJSON-Zeile an — Betriebsdaten
# (Kill-Switch-Gründe, Heartbeat-Ausfälle), nicht versioniert.
/data/alerts.ndjson

# Audit-Spool (S1, v1.36.18): persistenter Fallback, wenn audit_log nicht
# schreibbar war. Läuft lokal, wird nach dem Nachzug geleert — nicht versioniert.
/data/audit-spool

# Live-Gate (Task 11): State-Files, Audit-Hash-Kette, Kill-Failsafe-Datei
# und Security-Suite-Stamp sind Laufzeit-/Deployment-Artefakte (aus CI),
# niemals versioniert.
/data/live-gate
/data/live-gate-test

# Setup-Protokolle (v1.30.0): scripts/setup-cachyos.sh schreibt jeden Lauf
# nach data/setup/setup-<Zeitstempel>.log — Laufzeitartefakt, nie versioniert.
/data/setup

# Scanner-Artefakte (Task 04): taegliche Universe-Snapshots werden lokal
# erzeugt und sind aus Registry + Historie reproduzierbar — nicht versioniert.
/artifacts

# Lokale Test-Datenbank (embedded-postgres) — Laufzeitcluster, nie versioniert;
# gitignored, damit `git stash -u` / Checkouts den Live-Cluster nicht anruhren.
/data/db

# Perp-Qualitätsreport (RMA-P2-02, Laufzeit-Artefakt)
/data/perpdata

# Regime-Snapshot-Evaluation (RMA-P2-01, Laufzeit-Artefakt)
