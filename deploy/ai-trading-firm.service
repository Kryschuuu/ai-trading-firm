#
# systemd-Unit für die autonome KI-Trading-Firma
#
# Installation:
#   sudo cp deploy/ai-trading-firm.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/ai-trading-firm.service   # User + Pfade anpassen!
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-trading-firm
#
# Logs:
#   journalctl -u ai-trading-firm -f
#
[Unit]
Description=Autonome KI-Trading-Firma (Paper-Trading)
Documentation=file:///home/DEIN_USER/ai-trading-firm/docs/HANDBUCH.md
After=network-online.target postgresql.service
Wants=network-online.target
# Bei Variante A läuft Ollama lokal — dann diese Zeile aktivieren:
# After=ollama.service

[Service]
Type=simple

# ---- ANPASSEN ----
User=DEIN_USER
Group=DEIN_USER
WorkingDirectory=/home/DEIN_USER/ai-trading-firm
# ------------------

EnvironmentFile=/home/DEIN_USER/ai-trading-firm/.env
# NODE_ENV=production ist bindend: der Auth-Boot-Guard (src/auth/authMode.ts,
# Befund C1/v1.36.13) verlangt in Produktion mindestens ein Token. Ohne
# FIRM_ADMIN_TOKEN/FIRM_API_TOKEN/FIRM_VIEWER_TOKEN in .env startet der Dienst
# nicht (ConfigurationError: AUTH_NOT_CONFIGURED). Bewusster Lokalbetrieb ohne
# Token: AUTH_MODE=local-open in .env — offen, aber ausdrücklich entschieden.
# SEC-01/v1.36.27: Mit Tokens ist auch ein unabhaengiges FIRM_SESSION_SECRET
# Pflicht (separat openssl rand -hex 32). Fehlend/ungueltig => Start verweigert.
# Nach Upgrade/Rotation alle Instanzen neu starten; alte Cookies neu anmelden.
Environment=NODE_ENV=production
Environment=PORT=3369
# Läuft ein Reverse Proxy (nginx/Traefik/Caddy) vor dem Dienst, gehört die
# Rate-Limit-Identität in die .env: TRUSTED_PROXY_IPS=<Proxy-IP oder CIDR>
# (Befund C2/v1.36.14). Der Proxy muss zusätzlich X-Verified-IP selbst setzen
# und einen vom Client mitgebrachten Wert überschreiben, z. B. nginx:
#   proxy_set_header X-Verified-IP $remote_addr;
# Ohne diese Konfiguration ignoriert die App x-forwarded-for/x-real-ip und
# bildet einen gemeinsamen Bucket ("local") — sicher, aber eng für Multi-User.
# Kontrolle: curl -s localhost:3369/api/auth/me | jq .rateLimitIdentity

ExecStart=/usr/bin/npm run start

# Neustartverhalten: der Dienst soll hartnäckig sein, aber nicht in einer
# Absturzschleife den Rechner belasten.
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Sauberes Herunterfahren, damit offene DB-Transaktionen abschließen können.
KillSignal=SIGTERM
TimeoutStopSec=30

# ---- Härtung ----
# Der Dienst braucht kein Root, keine fremden Verzeichnisse und keine neuen Rechte.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/DEIN_USER/ai-trading-firm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Speicherbremse: verhindert, dass ein Leck den N150 in den Swap treibt.
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-firm

[Install]
WantedBy=multi-user.target
