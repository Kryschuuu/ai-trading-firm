[Unit]
Description=AI Trading Firm — Micro-Executor (LLM-frei, WebSocket-gesteuert)
Documentation=https://github.com/Kryschuuu/ai-trading-firm/blob/main/docs/HANDBUCH.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=atf
Group=atf
WorkingDirectory=/opt/ai-trading-firm
EnvironmentFile=/opt/ai-trading-firm/.env
# Der Mikro-Zyklus ist bewusst ein eigener, schlanker Prozess: kein Next.js,
# keine LLM-Calls — nur Feed → Regelauswertung → Broker.
ExecStart=/usr/bin/node --import tsx scripts/micro-executor.ts
Restart=on-failure
RestartSec=5
# Wie die Haupt-Unit: nur die vorbereiteten Laufzeitverzeichnisse sind schreibbar.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai-trading-firm/data /opt/ai-trading-firm/.runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Ressourcen: niedrig halten — der Prozess ist auf Latenz, nicht auf CPU gebaut.
MemoryMax=512M
# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-trading-firm-micro

[Install]
WantedBy=multi-user.target
